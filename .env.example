# Docker Compose settings. Copy to `.env` and replace every CHANGE_ME value.
# Never commit `.env`. All values here are local-development only.

# PostgreSQL owner (runs migrations; bypasses RLS as table owner)
POSTGRES_PASSWORD=CHANGE_ME_min_12_chars
# Runtime API role `dcp_app` (subject to row-level security; min 12 chars)
APP_DB_PASSWORD=CHANGE_ME_min_12_chars
# Password given to all 8 synthetic demo users by the seed (stored as bcrypt; min 12 chars)
SEED_DEMO_PASSWORD=CHANGE_ME_min_12_chars

REDIS_PASSWORD=CHANGE_ME_min_12_chars
MINIO_ROOT_USER=dcp-minio
MINIO_ROOT_PASSWORD=CHANGE_ME_min_12_chars

LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API directly (nginx proxies /api, so usually empty)
CORS_ORIGINS=

# Host ports (bound to 127.0.0.1)
DB_PORT=5432
API_PORT=3000
WEB_PORT=8080
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Optional S3-compatible evidence storage (`docker compose --profile storage up`)
# MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z

# --- F04 authentication (all optional; defaults shown) ---
DEFAULT_TENANT_CODE=ASSAM-DEMO
# Set true when served over HTTPS (cookies get the Secure attribute).
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=30
INVITE_TOKEN_HOURS=72
# Base URL used in reset/invite links.
APP_BASE_URL=http://localhost:8080
# file = write messages to MAIL_OUTBOX_DIR (no external mail provider configured); none = discard
MAIL_TRANSPORT=file
