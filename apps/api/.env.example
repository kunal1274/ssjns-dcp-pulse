# API settings for running outside Docker (`pnpm --filter @dcp/api dev`). Copy to apps/api/.env.
# Runtime connection: non-owner role, subject to row-level security.
DATABASE_URL=postgresql://dcp_app:CHANGE_ME@localhost:5432/dcp_pulse?schema=public
# Owner connection: migrations, role bootstrap, seed and drift check only.
MIGRATION_DATABASE_URL=postgresql://dcp_owner:CHANGE_ME@localhost:5432/dcp_pulse?schema=public
# Password set on the dcp_app role by `pnpm db:bootstrap-roles` (must match DATABASE_URL; min 12 chars)
APP_DB_PASSWORD=CHANGE_ME
# Password for the 8 synthetic demo users (min 12 chars; stored only as an Argon2id hash)
SEED_DEMO_PASSWORD=CHANGE_ME
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=

# --- F04 authentication (all optional; defaults shown) ---
DEFAULT_TENANT_CODE=ASSAM-DEMO
# Set true when served over HTTPS (cookies get the Secure attribute).
COOKIE_SECURE=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
RESET_TOKEN_MINUTES=30
INVITE_TOKEN_HOURS=72
# Base URL used in reset/invite links.
APP_BASE_URL=http://localhost:5173
# file = write messages to MAIL_OUTBOX_DIR (no external mail provider configured); none = discard
MAIL_TRANSPORT=file
MAIL_OUTBOX_DIR=var/mail-outbox
