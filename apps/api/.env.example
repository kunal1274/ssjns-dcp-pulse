# API settings for running outside Docker (`pnpm --filter @dcp/api dev`). Copy to apps/api/.env.
# Runtime connection: non-owner role, subject to row-level security.
DATABASE_URL=postgresql://dcp_app:CHANGE_ME@localhost:5432/dcp_pulse?schema=public
# Owner connection: migrations, role bootstrap, seed and drift check only.
MIGRATION_DATABASE_URL=postgresql://dcp_owner:CHANGE_ME@localhost:5432/dcp_pulse?schema=public
# Password set on the dcp_app role by `pnpm db:bootstrap-roles` (must match DATABASE_URL; min 12 chars)
APP_DB_PASSWORD=CHANGE_ME
# Password for the 8 synthetic demo users (min 12 chars; stored only as a bcrypt hash)
SEED_DEMO_PASSWORD=CHANGE_ME
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=
