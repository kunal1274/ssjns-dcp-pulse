model AlertRule {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String        @map("tenant_id") @db.Uuid
  ruleCode            String        @map("rule_code") @db.VarChar(50)
  scopeType           ScopeType     @map("scope_type")
  scopeId             String        @map("scope_id") @db.Uuid
  effectiveFrom       DateTime      @map("effective_from") @db.Date
  effectiveTo         DateTime?     @map("effective_to") @db.Date
  thresholdJson       Json          @map("threshold_json")
  severity            AlertSeverity
  ownerRoleCode       String        @map("owner_role_code") @db.VarChar(50)
  notificationChannel String        @map("notification_channel") @db.VarChar(30)
  dedupKeyTemplate    String        @map("dedup_key_template") @db.VarChar(200)
