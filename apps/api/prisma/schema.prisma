  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@map("import_batches")
}

model ExternalRecordMapping {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sourceSystem String   @map("source_system") @db.VarChar(50)
  entityType   String   @map("entity_type") @db.VarChar(50)
  externalId   String   @map("external_id") @db.VarChar(200)
  internalId   String   @map("internal_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by") @db.Uuid
  version      Int      @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sourceSystem, entityType, externalId])
  @@map("external_record_mappings")
}

/// Server-side session. Only SHA-256 hashes of the session and CSRF tokens are stored.
model UserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash     String    @map("csrf_token_hash") @db.Char(64)
  idleExpiresAt     DateTime  @map("idle_expires_at") @db.Timestamptz(6)
  absoluteExpiresAt DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason     String?   @map("revoked_reason") @db.VarChar(50)
  ipAddress         String?   @map("ip_address") @db.VarChar(64)
  userAgent         String?   @map("user_agent") @db.VarChar(300)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, userId])
  @@map("user_sessions")
}

/// Expiring, single-use token for password reset or invitation acceptance. Only the hash is stored.
model PasswordResetToken {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  tokenHash String       @unique @map("token_hash") @db.Char(64)
  purpose   TokenPurpose
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?      @map("created_by") @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@index([tenantId, userId])
  @@map("password_reset_tokens")
}

/// Append-only security log of authentication activity (login, logout, reset, lockout).
model AuthenticationEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  eventType   String   @map("event_type") @db.VarChar(50)
  outcome     String   @db.VarChar(20)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent") @db.VarChar(300)
  requestId   String?  @map("request_id") @db.VarChar(100)
  detailsJson Json?    @map("details_json")
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([tenantId, occurredAt])
  @@index([tenantId, userId])
  @@map("authentication_events")
}

/// Revision of an approved budget ceiling or allocation; applied only when a different user approves it.
model BudgetRevision {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  targetType      String    @map("target_type") @db.VarChar(20)
  budgetVersionId String?   @map("budget_version_id") @db.Uuid
  allocationId    String?   @map("allocation_id") @db.Uuid
  previousAmount  Decimal   @map("previous_amount") @db.Decimal(18, 2)
  requestedAmount Decimal   @map("requested_amount") @db.Decimal(18, 2)
  reason          String
  status          String    @default("PENDING") @db.VarChar(20)
  requestedById   String    @map("requested_by") @db.Uuid
  decidedById     String?   @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionComment String?   @map("decision_comment")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version         Int       @default(1)

  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  budgetVersion BudgetVersion?    @relation(fields: [tenantId, budgetVersionId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  allocation    BudgetAllocation? @relation(fields: [tenantId, allocationId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  requestedBy   User              @relation("BudgetRevisionRequestedBy", fields: [tenantId, requestedById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  decidedBy     User?             @relation("BudgetRevisionDecidedBy", fields: [tenantId, decidedById], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("budget_revisions")
}

/// Stored responses for sensitive writes, keyed per user, so retries do not repeat the write.
model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  key            String   @db.VarChar(100)
  route          String   @db.VarChar(200)
  requestHash    String   @map("request_hash") @db.Char(64)
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, userId, key])
  @@map("idempotency_keys")
}
