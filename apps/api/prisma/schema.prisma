  createdBy           String?       @map("created_by") @db.Uuid
  version             Int           @default(1)

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  alerts Alert[]

  @@unique([tenantId, id])
  @@unique([tenantId, ruleCode, scopeType, scopeId, effectiveFrom])
  @@map("alert_rules")
}

model Alert {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  schemeId    String?       @map("scheme_id") @db.Uuid
  ruleId      String?       @map("rule_id") @db.Uuid
  ruleCode    String        @map("rule_code") @db.VarChar(50)
  /// Deterministic key so repeated detection runs never create duplicates.
  dedupKey    String        @map("dedup_key") @db.VarChar(300)
  severity    AlertSeverity
  status      AlertStatus   @default(OPEN)
  assigneeId  String?       @map("assignee_id") @db.Uuid
  dueAt       DateTime?     @map("due_at") @db.Timestamptz(6)
  detectedAt  DateTime      @map("detected_at") @db.Timestamptz(6)
  contextJson Json          @default("{}") @map("context_json")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?       @map("created_by") @db.Uuid
  version     Int           @default(1)

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  scheme            Scheme?            @relation(fields: [tenantId, schemeId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  rule              AlertRule?         @relation(fields: [tenantId, ruleId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  assignee          User?              @relation("AlertAssignee", fields: [tenantId, assigneeId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  correctiveActions CorrectiveAction[]

  @@unique([tenantId, id])
  @@unique([tenantId, dedupKey])
  @@index([tenantId, status])
  @@index([tenantId, schemeId])
  @@map("alerts")
}

model CorrectiveAction {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                 @map("tenant_id") @db.Uuid
  alertId           String                 @map("alert_id") @db.Uuid
