// DCP Pulse logical data model (specification §4).
//
// Tenant design: every tenant-owned table carries `tenant_id`. Parents expose a
// composite unique key (tenant_id, id) and children reference it with a
// composite foreign key, so a row can never point at another tenant's data.
// Row-level security, PostGIS indexes, CHECK constraints and integrity triggers
// live in hand-written SQL migrations (see prisma/migrations/*_integrity_rls).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("MIGRATION_DATABASE_URL")
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("tenant_status")
}

enum RecordStatus {
  ACTIVE
  INACTIVE

  @@map("record_status")
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
  INVITED
  SUSPENDED

  @@map("user_status")
}

enum TokenPurpose {
  PASSWORD_RESET
  INVITE

  @@map("token_purpose")
}

enum ScopeType {
  TENANT
  JURISDICTION
  AGENCY
  SCHEME

  @@map("scope_type")
}

enum PermissionEffect {
  ALLOW
  DENY

  @@map("permission_effect")
}

enum FinancialYearStatus {
  PLANNED
  OPEN
  CLOSED

  @@map("financial_year_status")
}

enum SchemeStatus {
  DRAFT
  SUBMITTED
  RETURNED
  APPROVED
  ACTIVE
  SUSPENDED
  COMPLETED
  CLOSED
  CANCELLED

  @@map("scheme_status")
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("milestone_status")
}

enum BudgetVersionStatus {
  DRAFT
  APPROVED
  SUPERSEDED

  @@map("budget_version_status")
}

enum AllocationStatus {
  DRAFT
  APPROVED
  CANCELLED

  @@map("allocation_status")
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum CommitmentStatus {
  OPEN
  FULFILLED
  CANCELLED

  @@map("commitment_status")
}

enum ExpenditureStatus {
  DRAFT
  SUBMITTED
  VERIFIED
  RETURNED
  REJECTED

  @@map("expenditure_status")
}

enum ProgressStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  RETURNED
  RESUBMITTED

  @@map("progress_status")
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
  REJECTED

  @@map("scan_status")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED

  @@map("alert_status")
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("alert_severity")
}

enum CorrectiveActionStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED

  @@map("corrective_action_status")
}

enum ImportBatchStatus {
  RECEIVED
  VALIDATING
  VALIDATED
  FAILED
  COMMITTED

  @@map("import_batch_status")
}

// ---------------------------------------------------------------------------
// Tenancy, jurisdictions, agencies
// ---------------------------------------------------------------------------

model Tenant {
  budgetRevisions BudgetRevision[]
  idempotencyKeys IdempotencyKey[]
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String           @db.VarChar(200)
  code            String           @unique @db.VarChar(50)
  status          TenantStatus     @default(ACTIVE)
  settingsJson    Json             @default("{}") @map("settings_json")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?          @map("created_by") @db.Uuid
  version         Int              @default(1)

  jurisdictionTypes      JurisdictionType[]
  jurisdictions          Jurisdiction[]
  agencies               Agency[]
  agencyJurisdictions    AgencyJurisdiction[]
  users                  User[]
  userCredentials        UserCredential[]
  roles                  Role[]
  rolePermissions        RolePermission[]
  userRoleScopes         UserRoleScope[]
  financialYears         FinancialYear[]
  reportingPeriods       ReportingPeriod[]
  schemes                Scheme[]
  schemeLocations        SchemeLocation[]
  schemeMilestones       SchemeMilestone[]
  budgetVersions         BudgetVersion[]
  budgetRequests         BudgetRequest[]
  budgetAllocations      BudgetAllocation[]
  fundReleases           FundRelease[]
  commitments            Commitment[]
  expenditureRecords     ExpenditureRecord[]
  progressSubmissions    ProgressSubmission[]
  progressMeasurements   ProgressMeasurement[]
  evidenceFiles          EvidenceFile[]
  workflowDefinitions    WorkflowDefinition[]
  workflowInstances      WorkflowInstance[]
  approvalDecisions      ApprovalDecision[]
  alertRules             AlertRule[]
  alerts                 Alert[]
  correctiveActions      CorrectiveAction[]
  auditEvents            AuditEvent[]
  importBatches          ImportBatch[]
  externalRecordMappings ExternalRecordMapping[]
  userSessions           UserSession[]
  passwordResetTokens    PasswordResetToken[]
  authenticationEvents   AuthenticationEvent[]

  @@map("tenants")
}

model JurisdictionType {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String   @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy   String?  @map("created_by") @db.Uuid
  version     Int      @default(1)

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  jurisdictions Jurisdiction[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("jurisdiction_types")
}

model Jurisdiction {
  id        String                                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String                                       @map("tenant_id") @db.Uuid
  typeId    String                                       @map("type_id") @db.Uuid
  parentId  String?                                      @map("parent_id") @db.Uuid
  /// Ancestor ids from root to direct parent; maintained by trigger, used for scope filtering.
  ancestry  String[]                                     @default([]) @db.Uuid
  code      String                                       @db.VarChar(50)
  name      String                                       @db.VarChar(200)
  geometry  Unsupported("geometry(MultiPolygon, 4326)")?
  status    RecordStatus                                 @default(ACTIVE)
  createdAt DateTime                                     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                                     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?                                      @map("created_by") @db.Uuid
  version   Int                                          @default(1)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  type                JurisdictionType     @relation(fields: [tenantId, typeId], references: [tenantId, id])
  parent              Jurisdiction?        @relation("JurisdictionTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  children            Jurisdiction[]       @relation("JurisdictionTree")
  agencyJurisdictions AgencyJurisdiction[]
  schemes             Scheme[]
  budgetVersions      BudgetVersion[]
  budgetAllocations   BudgetAllocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@index([ancestry], type: Gin)
  @@map("jurisdictions")
}

model Agency {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String       @map("tenant_id") @db.Uuid
  code       String       @db.VarChar(50)
  name       String       @db.VarChar(200)
  agencyType String       @map("agency_type") @db.VarChar(50)
  status     RecordStatus @default(ACTIVE)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy  String?      @map("created_by") @db.Uuid
  version    Int          @default(1)

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  jurisdictions  AgencyJurisdiction[]
  schemes        Scheme[]
  budgetRequests BudgetRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("agencies")
}

model AgencyJurisdiction {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  agencyId         String    @map("agency_id") @db.Uuid
  jurisdictionId   String    @map("jurisdiction_id") @db.Uuid
  relationshipType String    @map("relationship_type") @db.VarChar(50)
  effectiveFrom    DateTime  @map("effective_from") @db.Date
  effectiveTo      DateTime? @map("effective_to") @db.Date
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?   @map("created_by") @db.Uuid
  version          Int       @default(1)

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  agency       Agency       @relation(fields: [tenantId, agencyId], references: [tenantId, id])
  jurisdiction Jurisdiction @relation(fields: [tenantId, jurisdictionId], references: [tenantId, id])

  @@unique([tenantId, agencyId, jurisdictionId, relationshipType, effectiveFrom])
  @@index([tenantId, jurisdictionId])
  @@map("agency_jurisdictions")
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model User {
  budgetRevisionsRequested BudgetRevision[] @relation("BudgetRevisionRequestedBy")
  budgetRevisionsDecided   BudgetRevision[] @relation("BudgetRevisionDecidedBy")
  id                       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                 String           @map("tenant_id") @db.Uuid
  email                    String           @db.VarChar(254)
  name                     String           @db.VarChar(200)
  status                   UserStatus       @default(ACTIVE)
  /// Reference to the credential record/provider; secrets are never stored on this table.
  credentialRef            String?          @map("credential_ref") @db.VarChar(200)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy                String?          @map("created_by") @db.Uuid
  version                  Int              @default(1)

  tenant                  Tenant                @relation(fields: [tenantId], references: [id])
  credential              UserCredential?
  roleScopes              UserRoleScope[]
  approvedBudgetVersions  BudgetVersion[]       @relation("BudgetVersionApprovedBy")
  submittedBudgetRequests BudgetRequest[]       @relation("BudgetRequestSubmittedBy")
  approvedAllocations     BudgetAllocation[]    @relation("AllocationApprovedBy")
  submittedExpenditure    ExpenditureRecord[]   @relation("ExpenditureSubmittedBy")
  verifiedExpenditure     ExpenditureRecord[]   @relation("ExpenditureVerifiedBy")
  progressSubmissions     ProgressSubmission[]  @relation("ProgressSubmittedBy")
  uploadedEvidence        EvidenceFile[]        @relation("EvidenceUploadedBy")
  approvalDecisions       ApprovalDecision[]
  assignedAlerts          Alert[]               @relation("AlertAssignee")
  correctiveActions       CorrectiveAction[]
  sessions                UserSession[]
  passwordResetTokens     PasswordResetToken[]
  authenticationEvents    AuthenticationEvent[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
  @@map("users")
}

/// Local credential store (bcrypt hash only). Kept apart from `users` so user reads never touch hashes.
model UserCredential {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  userId            String    @unique @map("user_id") @db.Uuid
  passwordHash      String    @map("password_hash") @db.VarChar(200)
  algorithm         String    @default("argon2id") @db.VarChar(20)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy         String?   @map("created_by") @db.Uuid
  version           Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])

  @@unique([tenantId, userId])
  @@map("user_credentials")
}

model Role {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  code             String       @db.VarChar(50)
  name             String       @db.VarChar(100)
  isSystemTemplate Boolean      @default(false) @map("is_system_template")
  description      String?      @db.VarChar(500)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?      @map("created_by") @db.Uuid
  version          Int          @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  userScopes  UserRoleScope[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("roles")
}

/// Global permission catalogue (not tenant-owned).
model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(100)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(50)
  description String   @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version     Int      @default(1)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  roleId       String           @map("role_id") @db.Uuid
  permissionId String           @map("permission_id") @db.Uuid
  effect       PermissionEffect @default(ALLOW)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy    String?          @map("created_by") @db.Uuid
  version      Int              @default(1)

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  role       Role       @relation(fields: [tenantId, roleId], references: [tenantId, id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRoleScope {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  roleId             String    @map("role_id") @db.Uuid
  scopeType          ScopeType @map("scope_type")
  /// Id of the tenant, jurisdiction, agency or scheme the role applies to.
  scopeId            String    @map("scope_id") @db.Uuid
  /// JURISDICTION scopes cover descendants only when explicitly enabled.
  includeDescendants Boolean   @default(false) @map("include_descendants")
  revokedBy          String?   @map("revoked_by") @db.Uuid
  revocationReason   String?   @map("revocation_reason")
  validFrom          DateTime  @default(now()) @map("valid_from") @db.Timestamptz(6)
  validTo            DateTime? @map("valid_to") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy          String?   @map("created_by") @db.Uuid
  version            Int       @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id])
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id])

  @@index([tenantId, userId])
  @@index([tenantId, scopeType, scopeId])
  @@map("user_role_scopes")
}

// ---------------------------------------------------------------------------
// Time
// ---------------------------------------------------------------------------

model FinancialYear {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String              @map("tenant_id") @db.Uuid
  code      String              @db.VarChar(20)
  startDate DateTime            @map("start_date") @db.Date
  endDate   DateTime            @map("end_date") @db.Date
  status    FinancialYearStatus @default(PLANNED)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?             @map("created_by") @db.Uuid
  version   Int                 @default(1)

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  reportingPeriods ReportingPeriod[]
  schemes          Scheme[]
  budgetVersions   BudgetVersion[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("financial_years")
}

/// Reporting period referenced as `period_id` by requests, expenditure and progress (e.g. "2026-11").
model ReportingPeriod {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  financialYearId String   @map("financial_year_id") @db.Uuid
  code            String   @db.VarChar(20)
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  submissionDueAt DateTime @map("submission_due_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by") @db.Uuid
  version         Int      @default(1)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  financialYear       FinancialYear        @relation(fields: [tenantId, financialYearId], references: [tenantId, id])
  budgetRequests      BudgetRequest[]
  expenditureRecords  ExpenditureRecord[]
  progressSubmissions ProgressSubmission[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("reporting_periods")
}

// ---------------------------------------------------------------------------
// Schemes
// ---------------------------------------------------------------------------

model Scheme {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  schemeCode      String       @map("scheme_code") @db.VarChar(50)
  name            String       @db.VarChar(300)
  category        String       @db.VarChar(50)
  financialYearId String       @map("financial_year_id") @db.Uuid
  agencyId        String       @map("agency_id") @db.Uuid
  jurisdictionId  String       @map("jurisdiction_id") @db.Uuid
  status          SchemeStatus @default(DRAFT)
  startDate       DateTime?    @map("start_date") @db.Date
  targetEndDate   DateTime?    @map("target_end_date") @db.Date
  description     String?
  objectives      String?
  department      String?      @db.VarChar(150)
  statusReason    String?      @map("status_reason")
  submittedById   String?      @map("submitted_by") @db.Uuid
  submittedAt     DateTime?    @map("submitted_at") @db.Timestamptz(6)
  approvedById    String?      @map("approved_by") @db.Uuid
  approvedAt      DateTime?    @map("approved_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy       String?      @map("created_by") @db.Uuid
  version         Int          @default(1)

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  financialYear       FinancialYear        @relation(fields: [tenantId, financialYearId], references: [tenantId, id])
  agency              Agency               @relation(fields: [tenantId, agencyId], references: [tenantId, id])
  jurisdiction        Jurisdiction         @relation(fields: [tenantId, jurisdictionId], references: [tenantId, id])
  locations           SchemeLocation[]
  milestones          SchemeMilestone[]
  budgetVersions      BudgetVersion[]
  budgetRequests      BudgetRequest[]
  budgetAllocations   BudgetAllocation[]
  fundReleases        FundRelease[]
  commitments         Commitment[]
  expenditureRecords  ExpenditureRecord[]
  progressSubmissions ProgressSubmission[]
  evidenceFiles       EvidenceFile[]
  alerts              Alert[]

  @@unique([tenantId, id])
  @@unique([tenantId, schemeCode])
  @@index([tenantId, jurisdictionId])
  @@index([tenantId, agencyId])
  @@index([tenantId, financialYearId, status])
  @@map("schemes")
}

model SchemeLocation {
  id               String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                                @map("tenant_id") @db.Uuid
  schemeId         String                                @map("scheme_id") @db.Uuid
  geometry         Unsupported("geography(Point, 4326)")
  locationAccuracy String                                @map("location_accuracy") @db.VarChar(50)
  source           String                                @db.VarChar(100)
  createdAt        DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy        String?                               @map("created_by") @db.Uuid
  version          Int                                   @default(1)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  scheme Scheme @relation(fields: [tenantId, schemeId], references: [tenantId, id])

  @@index([tenantId, schemeId])
  @@index([geometry], type: Gist)
  @@map("scheme_locations")
}

model SchemeMilestone {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  schemeId       String          @map("scheme_id") @db.Uuid
  name           String          @db.VarChar(300)
  targetDate     DateTime        @map("target_date") @db.Date
  targetQuantity Decimal         @map("target_quantity") @db.Decimal(18, 3)
  unit           String          @db.VarChar(30)
  /// Percentage weight within the scheme (0–100). Scheme-level sum rules are enforced by the service layer.
  weight         Decimal         @db.Decimal(5, 2)
  status         MilestoneStatus @default(NOT_STARTED)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy      String?         @map("created_by") @db.Uuid
  version        Int             @default(1)

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  scheme       Scheme                @relation(fields: [tenantId, schemeId], references: [tenantId, id])
  measurements ProgressMeasurement[]

  @@unique([tenantId, id])
  @@index([tenantId, schemeId])
  @@map("scheme_milestones")
}

// ---------------------------------------------------------------------------
// Financials (ledger-like, distinct record types)
// ---------------------------------------------------------------------------

model BudgetVersion {
  revisions         BudgetRevision[]
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  financialYearId   String              @map("financial_year_id") @db.Uuid
  /// Scheme budget; null when the version is an authorised planning envelope for a jurisdiction.
  schemeId          String?             @map("scheme_id") @db.Uuid
  jurisdictionId    String?             @map("jurisdiction_id") @db.Uuid
  versionNumber     Int                 @map("version_number")
  status            BudgetVersionStatus @default(DRAFT)
  totalAmount       Decimal             @map("total_amount") @db.Decimal(18, 2)
  currencyCode      String              @default("INR") @map("currency_code") @db.Char(3)
  revisionReason    String?             @map("revision_reason")
  approvedAt        DateTime?           @map("approved_at") @db.Timestamptz(6)
