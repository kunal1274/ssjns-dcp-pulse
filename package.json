{
  "name": "dcp-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "DCP Pulse \u2014 decentralised scheme monitoring demo (synthetic data only; not a government deployment).",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @dcp/shared build",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:shared && pnpm -r typecheck",
    "test": "pnpm build:shared && pnpm -r test",
    "test:integration": "pnpm build:shared && pnpm --filter @dcp/api test:integration",
    "db:bootstrap-roles": "pnpm --filter @dcp/api db:bootstrap-roles",
    "db:migrate": "pnpm --filter @dcp/api db:migrate",
    "db:drift-check": "pnpm --filter @dcp/api db:drift-check",
    "db:seed": "pnpm --filter @dcp/api db:seed",
    "db:setup": "pnpm build:shared && pnpm db:bootstrap-roles && pnpm db:migrate && pnpm db:seed",
    "test:e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.52.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  }
}
